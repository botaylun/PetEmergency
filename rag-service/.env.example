# ============================================================
# RAG SERVICE — môi trường
# Sao chép thành .env và điền giá trị thực
# ============================================================

# --- Kết nối MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pet_emergency
DB_USER=root
DB_PASSWORD=

# --- Embedding Model (chạy offline, miễn phí) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Kích thước vector của model trên: 384
EMBEDDING_DIM=384

# --- Gemini AI (để sinh hướng dẫn sơ cứu) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- RAG params ---
CHUNK_SIZE=500          # Số ký tự mỗi chunk
CHUNK_OVERLAP=50        # Ký tự overlap giữa các chunk
TOP_K=3                 # Số chunk lấy ra khi search
SIMILARITY_THRESHOLD=0.3  # Ngưỡng cosine similarity tối thiểu

# --- Service ---
PORT=8002
LOG_LEVEL=info
